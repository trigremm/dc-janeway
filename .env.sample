# Generate a stable per-host port from the repo URL:
# echo 'https://github.com/trigremm/dc-janeway' | md5sum - | tr -cd '[[:digit:]]' | awk '{print substr($0,1,2)}'
# → 8XY0 (e.g. 8090)

# Port where Janeway is published on the host (nginx proxies to this)
DC_JANEWAY_HTTP_PORT=8090

# Janeway source pin — tag or commit hash of BirkbeckCTP/janeway baked into the image.
# Bump this then `make build && make r` to upgrade.
JANEWAY_REF=v1.7.5

# Database (PostgreSQL)
POSTGRES_DB=janeway
POSTGRES_USER=janeway
POSTGRES_PASSWORD=change_me_db_password

# Django / Janeway
# Janeway uses JANEWAY_SETTINGS_MODULE (not DJANGO_SETTINGS_MODULE). Its loader
# starts with core.janeway_global_settings and merges overrides from the module
# named below. Keep this pointing at core.janeway_local_settings — we bind-mount
# config/janeway_local_settings.py over it so customisations live outside the image.
JANEWAY_SETTINGS_MODULE=core.janeway_local_settings
SECRET_KEY=change_me_with_openssl_rand_hex_32
DEBUG=0
ALLOWED_HOSTS=janeway.asmo.su,localhost

TZ=Asia/Almaty
