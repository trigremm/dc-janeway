# Generate a stable per-host port from the repo URL:
# echo 'https://github.com/trigremm/dc-janeway' | md5sum - | tr -cd '[[:digit:]]' | awk '{print substr($0,1,2)}'
# → 8XY0 (e.g. 8090)

# Port where janeway is published on the host (nginx proxies to this)
DC_JANEWAY_HTTP_PORT=8090

# Upstream pin — commit hash or tag of BirkbeckCTP/janeway to check out
JANEWAY_REF=v1.7.3

# Database (PostgreSQL is Janeway's default)
DB_VENDOR=postgres
POSTGRES_DB=janeway
POSTGRES_USER=janeway
POSTGRES_PASSWORD=change_me_db_password

# Django
DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=change_me_with_openssl_rand_hex_32
DEBUG=0
ALLOWED_HOSTS=janeway.asmo.su,localhost

# Admin bootstrap (used on first `make install`)
JANEWAY_ADMIN_EMAIL=admin@example.com
JANEWAY_ADMIN_PASSWORD=change_me_admin_password

TZ=Asia/Almaty
